#--------------------------------------------------------------------
# PRODUCTION .env TEMPLATE for demo.jobberrecruit.com (cPanel)
#
# Copy this to `.env` on the server and fill in the CHANGE_ME values.
# NEVER commit the filled-in file or upload it anywhere public.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://demo.jobberrecruit.com/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE (from cPanel > MySQL Databases)
# cPanel DB names are prefixed with the account name, e.g. jobbcfsf_
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = jobbcfsf_CHANGE_ME
database.default.username = jobbcfsf_CHANGE_ME
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBDebug = false

#--------------------------------------------------------------------
# COOKIES / SESSION
#--------------------------------------------------------------------

cookie.secure = true

#--------------------------------------------------------------------
# EMAIL (cPanel > Email Accounts; use the mail subdomain cPanel shows)
#--------------------------------------------------------------------

email.fromEmail = 'no-reply@jobberrecruit.com'
email.fromName = 'JobberRecruit'
email.SMTPHost = 'mail.jobberrecruit.com'
email.SMTPUser = 'no-reply@jobberrecruit.com'
email.SMTPPass = 'CHANGE_ME'
email.SMTPPort = 465
email.SMTPCrypto = 'ssl'

#--------------------------------------------------------------------
# LOGGER (4 = errors + warnings only; writable/logs/)
#--------------------------------------------------------------------

logger.threshold = 4
