#--------------------------------------------------------------------
# PRODUCTION .env TEMPLATE for demo.jobberrecruit.com (cPanel)
#
# Copy this to `.env` on the server and fill in the CHANGE_ME values.
# NEVER commit the filled-in file or upload it anywhere public.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

app.baseURL = 'https://demo.jobberrecruit.com/'
app.forceGlobalSecureRequests = true

#--------------------------------------------------------------------
# DATABASE (from cPanel > MySQL Databases)
# cPanel DB names are prefixed with the account name, e.g. jobbcfsf_
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = jobbcfsf_CHANGE_ME
database.default.username = jobbcfsf_CHANGE_ME
database.default.password = CHANGE_ME
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.DBDebug = false

#--------------------------------------------------------------------
# COOKIES / SESSION
#--------------------------------------------------------------------

cookie.secure = true

#--------------------------------------------------------------------
# EMAIL (Mailtrap High-Deliverability Sending / SMTP)
#--------------------------------------------------------------------

email.fromEmail = 'info@jobberrecruit.com'
email.fromName = 'JobberRecruit'
email.SMTPHost = 'live.smtp.mailtrap.io'
email.SMTPUser = 'api'
email.SMTPPass = 'f61d16194a672c3c36fe382d5ebd2f76'
email.SMTPPort = 587
email.SMTPCrypto = 'tls'

# Optional Mailtrap REST API token (used for automatic failover over HTTPS port 443)
MAILTRAP_API_TOKEN = 'f61d16194a672c3c36fe382d5ebd2f76'

# Set to false to send automatic emails immediately via Mailtrap (no cron dependency)
email.use_queue = false

# Internal pseudo-cron: runs automations opportunistically so you do not totally rely on external cron jobs
internal_cron_enabled = true
internal_cron_interval = 900


#--------------------------------------------------------------------
# AI / GEMINI (Google AI Studio key)
# The variable name must match exactly; adding a key elsewhere in cPanel
# does not make it available to PHP unless it reaches the app environment.
#--------------------------------------------------------------------

GEMINI_API_KEY = 'CHANGE_ME'
GEMINI_MODEL = 'gemini-3.5-flash-lite'

# AI Model Router Task Overrides (Optional)
GEMINI_MODEL_CHAT = 'gemini-3.5-flash-lite'
GEMINI_MODEL_FAST = 'gemini-3.5-flash-lite'
GEMINI_MODEL_BALANCED = 'gemini-3.5-flash-lite'
GEMINI_MODEL_REASONING = 'gemini-3.5-flash-lite'
GEMINI_MODEL_AUDIO = 'gemini-3.1-flash'
GEMINI_TTS_MODEL = 'gemini-3.1-flash-tts-preview'

# Automations & Web Cron Token
cron_token = 'jobber_cron_secret_123'

#--------------------------------------------------------------------
# BROWSERSHOT / PDF GENERATION (cPanel / Server Node & npm paths)
# To use Browsershot (high-fidelity Chromium rendering) on server,
# specify the server's Node & npm paths (e.g. /usr/bin/node or /usr/local/bin/node).
# If not specified or missing, PDF generation will fall back to Dompdf.
#--------------------------------------------------------------------
node_binary_path = '/usr/bin/node'
npm_binary_path  = '/usr/bin/npm'


logger.threshold = 4
